#!/usr/bin/env bash
# klip-gta: jalankan dengan environment Python skill ini sendiri (uv). Mac, Linux, Git Bash di Windows.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo "uv belum terpasang. Mac: brew install uv  ·  Windows: winget install astral-sh.uv" >&2
  exit 1
fi
export PYTHONUTF8=1
exec uv run --quiet --project "$HERE" python "$HERE/scripts/klip.py" "$@"
